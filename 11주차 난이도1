def quick_sort(a, left, right,count):
    pl = left              #왼쪽 커서 
    pr = right             #오른쪽 커서 
    pivot = a[(left + right) // 2]    #피벗 

    while pl <= pr:
        while a[pl] < pivot: pl += 1
        while a[pr] > pivot: pr -= 1
        if pl <= pr:
            a[pl], a[pr] = a[pr], a[pl]  
            pl += 1
            pr -= 1

    if left < pr:
        quick_sort(a, left, pr)  
    if pl < right:
        quick_sort(a, pl, right)  


num = int(input('원소 수를 입력하세요: '))
x = [None] * num

for i in range(num):
    x[i] = int(input(f'x[{i}]: '))

quick_sort(x, 0, num - 1)

