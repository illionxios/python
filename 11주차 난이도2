import random
import time

num = int(input('원소 수를 입력하세요: '))
x = list(range(1, num + 1))
random.shuffle(x)

print('랜덤배열:', x)

count=0

startTime = time.perf_counter()
for i in range(len(x)):
    for j in range(len(x)-i-1):
        if x[j] > x[j+1]:
            x[j] , x[j+1] = x[j+1] , x[j]
            count+=1
            
endTime = time.perf_counter()

totalTime = endTime - startTime


print('정렬된배열:', x)
print("계산횟수:",count)
print(f'계산시간:{totalTime:.9f}초')
